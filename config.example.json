  "background": {
    "image": "examples/demo.jpg",
    "blur": 22.0,
    "brightness": 0.5,
    "zoom": 1.14,
    "beat_zoom": 0.018,
    "shake": 3.0,
    "grain": 0.045
  },

  "cover": {
    "enabled": true,
    "shape": "circle",
    "size": 440,
    "position": [0.5, 0.44],
    "beat_scale": 0.03,
    "spin": 0.0
  },

  "visualizer": {
    "style": "circle",
    "radius": 262.0,
    "amplitude": 150.0,
